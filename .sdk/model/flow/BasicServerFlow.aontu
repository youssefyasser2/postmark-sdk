# BasicServerFlow

main: kit: flow: BasicServerFlow:
{
  entity: "server",
  kind: "basic",
  name: "BasicServerFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "server_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "server_ref01",
        srcdatavar: "server_ref01_data",
        suffix: "_up0",
        textfield: "BounceHookUrl"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-server_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicServerFlow"
}